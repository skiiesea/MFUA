# ── Основное ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Публичный адрес приложения (для ссылок в письмах, CORS, проверки Origin). Можно несколько через запятую.
CLIENT_URL=http://localhost:5173
# Количество reverse-proxy перед сервером (0 — без прокси, 1 — nginx/Caddy)
TRUST_PROXY=0

# ── База данных ──────────────────────────────────────────
DATABASE_URL=postgresql://vesper:vesper_dev_password@localhost:5432/vesper?schema=public

# ── Секреты (ОБЯЗАТЕЛЬНО сгенерируйте свои!) ─────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Почта (в development код подтверждения выводится в консоль сервера) ──
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vesper <no-reply@example.com>"

# ── Файлы и логи ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
LOG_DIR=../logs
LOG_LEVEL=info
LOG_MAX_SIZE=10M
LOG_MAX_FILES=14

# ── Cookie ───────────────────────────────────────────────
# true в продакшене (HTTPS). Если пустое — берётся автоматически из NODE_ENV.
COOKIE_SECURE=

# ── Раздача собранного фронтенда (npm run build) ─────────
STATIC_DIR=../web/dist
